# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vividya_db

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# APIs
SARVAM_API_KEY=sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai/v1
NVIDIA_NIM_API_KEY=nvidia_api_key_here
NVIDIA_NIM_API_URL=https://integrate.api.nvidia.com/v1

# Google OAuth
GOOGLE_CLIENT_ID=client_id_here
GOOGLE_CLIENT_SECRET=client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# S3 / File Storage
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_S3_BUCKET=vividya-uploads
AWS_REGION=ap-south-1

# Server Config
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=debug

# Vector DB
PINECONE_API_KEY=pinecone_key
PINECONE_ENVIRONMENT=us-west-2
PINECONE_INDEX=vividya-knowledge
